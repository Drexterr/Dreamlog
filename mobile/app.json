{
  "expo": {
    "name": "Ode",
    "slug": "dreamlog",
    "version": "1.0.0",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/50f4468b-705b-4288-a7a2-e60b6fb5138a",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "preview"
      }
    },
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#18150f",
    "scheme": "ode",
    "icon": "./assets/icon.png",
    "splash": {
      "backgroundColor": "#18150f"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-updates",
        {
          "channel": "preview"
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow Ode to access your microphone to record voice journals."
        }
      ],
      "expo-font",
      "expo-secure-store",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.302666329017-hn90suhcrsvftliko5shh1botmd0ghar"
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "expo-apple-authentication",
      "expo-iap",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Ode to access your photos so therapists can upload photos of session notes.",
          "cameraPermission": "Allow Ode to use the camera so therapists can photograph session notes."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://de.sentry.io/",
          "organization": "bharat-jain-i5",
          "project": "ode-mobile"
        }
      ],
      "expo-web-browser"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.talktoode.app",
      "usesAppleSignIn": true,
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Allow Ode to access your microphone to record voice journals.",
        "NSHealthUpdateUsageDescription": "Ode writes a Mindful Session to Apple Health after each completed journal entry.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.healthkit": true
      }
    },
    "android": {
      "backgroundColor": "#18150f",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#18150f"
      },
      "package": "com.ode.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "50f4468b-705b-4288-a7a2-e60b6fb5138a"
      }
    },
    "owner": "drexterr"
  }
}
