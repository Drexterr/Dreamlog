# Android SDK local path - machine-specific, never commit
mobile/android/local.properties

# Firebase config - contains API keys, inject via CI/CD
mobile/google-services.json
mobile/android/app/google-services.json
mobile/GoogleService-Info.plist

# Therapist portal build artifacts - deploy from a local build, don't commit
therapist-portal/out/
therapist-portal/.firebase/

# Environment variables - never commit real secrets
.env
.env.local
.env.*.local
.env.production

# Keep the example file
!.env.example

# Go
backend/bin/
backend/*.exe
backend/vendor/
*.test
*.out

# Node / React Native / Expo
node_modules/
mobile/node_modules/
therapist-portal/node_modules/
web/node_modules/
.expo/
mobile/.expo/
dist/
build/
.next/
therapist-portal/.next/
web/.next/
*.tgz

# IDE / OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Claude Code internal
.claude/
.antigravitycli/

# Logs
*.log
npm-debug.log*

# Coverage
coverage/
coverage.out

# Maestro E2E screenshots - `maestro test` writes takeScreenshot output to the
# cwd it's run from; only /maestro/screenshots/ is the intended destination.
/*.png
